[internationalization]

locale/include_text_server_data=true

[layer_names]

2d_physics/layer_1="tanks_player"
2d_physics/layer_2="tanks_enemy"
2d_physics/layer_3="bullet_player"
2d_physics/layer_4="bullet_enemy"
2d_physics/layer_5="destructible"
2d_physics/layer_6="grass"
2d_physics/layer_7="ice"
2d_physics/layer_8="water"
2d_physics/layer_9="drops"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
rendering/rendering_device/driver.windows="vulkan"
