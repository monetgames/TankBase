; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="坦克基地"
config/description="《坦克基地》是一款融合 RPG、塔防与 Roguelite 元素的坦克攻防游戏。"
config/version="0.3.0"
run/main_scene="uid://yhbnccsafmod"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://sprites/base_player_256.png"
config/macos_native_icon="res://sprites/logo-mac.icns"
config/windows_native_icon="res://sprites/logo-win.ico"

[autoload]

GameLog="*res://scripts/autoload/logger.gd"
ConfigLoader="*res://scripts/autoload/config_loader.gd"
DamageCalculator="*res://scripts/damage_calculator.gd"
GM="*res://scripts/game_manager.gd"
GameState="*res://scripts/resources/game_state.gd"
EconomySystem="*res://scripts/autoload/economy_system.gd"
DropSystem="*res://scripts/autoload/drop_system.gd"
ItemSystem="*res://scripts/autoload/item_system.gd"
EquipmentSystem="*res://scripts/autoload/equipment_system.gd"
WaveManager="*res://scripts/autoload/wave_manager.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
Tutorial="*res://scripts/autoload/tutorial_manager.gd"
MCPRuntime="*res://scripts/autoload/mcp_runtime_loader.gd"

[debug]

file_logging/enable_file_logging.pc=false

[display]

window/size/viewport_width=640
window/size/viewport_height=600
window/size/window_width_override=1280
window/size/window_height_override=1200
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[gui]

theme/custom="res://themes/military_theme.tres"

